{
	"name": "pi-oxidized",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Rust rewrite of the pi coding agent. Root workspace owns the TypeScript extension host package and the cross-target release scripts that bundle the Rust binary beside its source-pinned host sidecar.",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "tsc --noEmit -p scripts/tsconfig.json",
		"test": "bun test scripts",
		"build:extension-host": "bun run scripts/build-extension-host.ts",
		"package-release": "bun run scripts/package-release.ts",
		"package-release:dry": "bun run scripts/package-release.ts --dry-run",
		"verify:compatibility": "bun run scripts/verification/compat-matrix.ts",
		"verify:e2e": "bun run scripts/verification/e2e-smoke.ts",
		"verify:performance": "bun run scripts/verification/performance.ts",
		"verify:extension-scaling": "bun run scripts/bench-extension-scaling.ts"
	},
	"devDependencies": {
		"@types/bun": "1.3.9",
		"typescript": "5.9.3"
	},
	"engines": {
		"bun": ">=1.3.5"
	},
	"license": "MIT"
}
