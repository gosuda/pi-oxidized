{
	"name": "pi-oxidized",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Rust rewrite of the pi coding agent. Root workspace owns the TypeScript extension host package and the cross-target release scripts that bundle the Rust binary beside its source-pinned host sidecar.",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "tsc --noEmit -p scripts/tsconfig.json",
		"test": "bun test scripts",
		"build:extension-host": "bun run scripts/build-extension-host.ts",
		"package-release": "bun run scripts/package-release.ts",
		"package-release:dry": "bun run scripts/package-release.ts --dry-run",
		"verify:alignment": "bun run scripts/verification/alignment.ts",
		"verify:compatibility": "bun run scripts/verification/compat-matrix.ts",
		"verify:dependency-exposure": "bun run scripts/verification/dependency-exposure.ts",
		"verify:e2e": "bun run scripts/verification/e2e-smoke.ts",
		"verify:map-ledger": "bun run scripts/verification/map.ts",
		"verify:fog": "bun run scripts/verification/fog.ts",
		"verify:arbitration": "bun run scripts/verification/arbitration.ts",
		"verify:gates": "bun run scripts/verification/gates.ts",
		"verify:replacement": "bun run scripts/verification/e2e-smoke.ts --replacement-only",
		"verify:parity": "bun run scripts/verification/parity.ts",
		"verify:sbom": "bun run scripts/verification/deps-sbom.ts verify",
		"verify:performance": "bun run scripts/verification/performance.ts",
		"verify:footprint": "bun run scripts/verification/footprint.ts",
		"gen:par-wire-corpus": "bun run scripts/verification/gen-par-wire-corpus.ts",
		"verify:style-ledger": "bun run scripts/verification/style-ledger.ts",
		"verify:syntect-ignores": "bun run scripts/verification/syntect-ignores.ts",
		"verify:snippets": "bun run scripts/verification/snippet-harness.ts",
		"verify:extension-scaling": "bun run scripts/bench-extension-scaling.ts",
		"gen:compat-docs": "bun run scripts/verification/generate-compat-docs.ts",
		"verify:compat-docs": "bun run scripts/verification/generate-compat-docs.ts",
		"gen:execution-map": "bun run scripts/verification/fetch-map-source.ts | bun run scripts/verification/publish-map.ts"
	},
	"devDependencies": {
		"@types/bun": "1.4.0",
		"typescript": "7.0.2"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"license": "MIT",
	"dependencies": {
		"ignore": "7.0.6"
	}
}
