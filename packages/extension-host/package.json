{
	"name": "@earendil-works/pi-extension-host",
	"version": "0.80.10",
	"description": "Bundled TypeScript extension host for the pi coding agent — drives the REAL ExtensionRunner over a structured JSONL bridge",
	"type": "module",
	"license": "MIT",
	"main": "./src/main.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/main.ts"
		},
		"./sanitize": {
			"types": "./src/sanitize.ts",
			"import": "./src/sanitize.ts"
		},
		"./protocol": {
			"types": "./src/protocol.ts",
			"import": "./src/protocol.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.check.json",
		"build": "bun build ./src/main.ts --compile --minify --compile-autoload-tsconfig --compile-autoload-package-json --outfile dist/pi-extension-host",
		"build:bundle": "bun build ./src/main.ts --outdir dist --target bun --minify",
		"test": "bun test tests",
		"fixture:runtime-import": "bun run fixtures/runtime-import.ts"
	},
	"dependencies": {
		"@earendil-works/pi-tui-protocol": "file:../pi-tui-protocol",
		"jiti": "2.7.0",
		"typebox": "1.1.38"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "file:../../.references/pi/packages/agent",
		"@earendil-works/pi-ai": "file:../../.references/pi/packages/ai",
		"@earendil-works/pi-coding-agent": "file:../../.references/pi/packages/coding-agent",
		"@earendil-works/pi-tui": "file:../../.references/pi/packages/tui",
		"@types/bun": "1.3.9",
		"typebox": "1.1.38",
		"typescript": "5.9.3"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"keywords": [
		"pi",
		"extension",
		"host",
		"bridge",
		"jsonl"
	]
}
